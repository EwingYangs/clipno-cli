{
  "name": "clipno",
  "version": "0.1.0",
  "description": "Save any link to Notion from your terminal. Extract any URL into structured data.",
  "keywords": ["notion", "clipper", "cli", "bookmark", "web-clipper"],
  "license": "MIT",
  "type": "module",
  "bin": { "clipno": "dist/index.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "commander": "^12.1.0" },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
